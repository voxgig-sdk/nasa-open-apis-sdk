# BasicPlanetaryFlow

main: kit: flow: BasicPlanetaryFlow:
{
  entity: "planetary",
  kind: "basic",
  name: "BasicPlanetaryFlow",
  step: [
    {
      i: {
        ref: "planetary_ref01",
        srcdatavar: "planetary_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-planetary_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPlanetaryFlow"
}